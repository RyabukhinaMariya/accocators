cabal-version: 2.2

name:           accocators
version:        0.1.0.0
author:         Рябухина Мария
maintainer:     Ryabukhina_Mariya@mail.ru
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md

library
  exposed-modules:
      FreeListAllocator
      PoolAllocator
  other-modules:
      Paths_accocators
  autogen-modules:
      Paths_accocators
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , containers
  default-language: Haskell2010

test-suite accocators-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      TestFreeListAllocator
      TestPoolAllocator
      Paths_accocators
  autogen-modules:
      Paths_accocators
  hs-source-dirs:
      test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      accocators
    , base >=4.7 && <5
    , containers
    , hedgehog
  default-language: Haskell2010
